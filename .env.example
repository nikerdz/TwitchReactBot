# Copy this file to .env and fill in the values. Do NOT commit your .env

# Twitch bot settings
TWITCH_CHANNEL=your_streamer_channel
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_OAUTH_TOKEN=oauth:your_oauth_token

# Prefer using client credentials for server-to-server requests (keep these private)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

PORT=5173
